{
	"name": "todai-league",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"clean:cf": "rm -rf .svelte-kit/cloudflare .svelte-kit/output",
		"gen": "pnpm run clean:cf && wrangler types",
		"gen:check": "pnpm run clean:cf && wrangler types --check",
		"build": "pnpm run gen:check && vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync && lefthook install || echo ''",
		"check": "pnpm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ci": "pnpm run gen:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:coverage": "vitest run --coverage",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "pnpm dlx auth@latest generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"deploy": "pnpm run build && wrangler deploy -c wrangler.jsonc"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.18.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/d3": "^7.4.3",
		"@types/node": "^25.9.3",
		"@vitest/browser-playwright": "^4.1.9",
		"@vitest/coverage-v8": "^4.1.9",
		"better-auth": "1.6.19",
		"better-sqlite3": "^12.11.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lefthook": "^2.1.9",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.9",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.100.0"
	},
	"dependencies": {
		"@dnd-kit/svelte": "^0.5.0",
		"@fontsource/line-seed-jp": "^5.2.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"d3": "^7.9.0",
		"partyserver": "^0.5.8",
		"partysocket": "^1.2.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"valibot": "^1.4.1"
	}
}
