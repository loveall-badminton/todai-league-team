# -----------------------------------------------------------------------------
# Optional: remote D1 / Drizzle credentials
# Used by drizzle-kit push, generate, migrate, and studio against Cloudflare D1.
# Not required for local UI work or for Worker deploys.
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# -----------------------------------------------------------------------------
# Local wrangler preview (pnpm preview)
# wrangler dev reads secrets from .dev.vars, not .env.
# BETTER_AUTH_SECRET is required for `pnpm preview` and any local work that
# touches auth. Generate one with:
#   pnpm dlx auth@latest secret
# -----------------------------------------------------------------------------
# BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Worker deployment runtime secrets — set with `wrangler secret put`
# Do NOT commit these values.
#
# BETTER_AUTH_URL: Optional. Leave unset in Workers to use the request origin
# automatically. Set only when forcing a canonical auth origin (e.g. custom
# domain).
#
# BACKUP_WORKER_URL / BACKUP_DOWNLOAD_TOKEN: Optional. Only needed when the
# backup Worker is deployed and the settings page should link to it.
# -----------------------------------------------------------------------------
# BETTER_AUTH_URL=""
# BACKUP_WORKER_URL=""
# BACKUP_DOWNLOAD_TOKEN=""
